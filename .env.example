# Server-only. Never use NEXT_PUBLIC_ for these values.
ADMIN_EMAIL=
# Generate with scripts/create-admin-hash.mjs; no plaintext password is stored.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Resend: server-only sending key scoped to the verified domain.
RESEND_API_KEY=
RESEND_FROM=bookings@vandlovubookings.co.za
RESEND_REPLY_TO=info@vandlovu.co.za,vandlovugroup@gmail.com

# Vercel only: create a persistent Turso/libSQL database. Never use a local file on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
